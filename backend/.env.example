# ==============================================================================
# Havenly Interiors — Backend Environment Configuration Template
# ==============================================================================

PORT=5001
NODE_ENV=development

# ------------------------------------------------------------------------------
# MongoDB Connection String
# ------------------------------------------------------------------------------
# Option 1: MongoDB Atlas Cloud (Recommended for production):
# 1. Sign up free at: https://www.mongodb.com/cloud/atlas
# 2. Create a free shared M0 cluster.
# 3. Create a database user in Security > Database Access.
# 4. In Security > Network Access, add IP 0.0.0.0/0 (or your current IP).
# 5. Click Connect > Drivers (Node.js) and copy the connection string.
# Example:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/havenly_interiors?retryWrites=true&w=majority
#
# Option 2: Local MongoDB:
# MONGODB_URI=mongodb://127.0.0.1:27017/havenly_interiors
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/havenly_interiors?retryWrites=true&w=majority

# JWT Secret for Admin Session Tokens
JWT_SECRET=havenly_luxury_secret_jwt_key_2026_super_secure

# Allowed Frontend Origins (CORS)
CLIENT_URL=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:5174

# Initial Admin Credentials (used by seed script: npm run seed:admin)
ADMIN_EMAIL=admin@havenlyinteriors.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=HavenlyLuxe2026!
ADMIN_NAME=Studio Principal
